# Server
PORT=3000
NODE_ENV=development

# PostgreSQL (Railway provides DATABASE_URL automatically)
DATABASE_URL=postgresql://user:password@localhost:5432/lightson

# Login: no variable needed. Players log in through the shared neufmois.app hub
# (https://neufmois.app/hub/auth.js); the server verifies their Supabase access
# token against the public JWKS. Login only works when the game is served from
# a *.neufmois.app domain (e.g. https://light.neufmois.app).
